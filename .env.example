# War Room needs no configuration file.
#
# Sign-in (Okta, Microsoft Entra ID), SCIM, email, LiveKit, the public address and admins are all
# set in Admin → Settings and stored (secrets encrypted) in the database. On first start the server
# prints a one-time setup link to create the first admin; `npm run setup-link` prints another.
#
# The variables below are optional. They are only for the server process itself; anything here
# that also has a setting in Admin → Settings is used as a starting value until an admin saves.

# PORT=3000
# DATA_DIR=./data          # database, generated keys
# NODE_ENV=production
# SESSION_SECRET=          # default: generated and kept in DATA_DIR/.session-secret
# INTEGRATIONS_KEY=        # default: derived from the session secret
